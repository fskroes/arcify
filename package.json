{
  "name": "arcify",
  "version": "4.0.3",
  "description": "A sidebar extension that replicates Arc browser's tab management system",
  "type": "module",
  "scripts": {
    "dev": "vite build --config vite.config.dev.js --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:zip": "pnpm run build && pnpm run zip",
    "zip": "node scripts/zip.js",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-dev *.zip",
    "info": "node scripts/build-info.js"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "archiver": "^6.0.1",
    "fs-extra": "^11.2.0",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vite-plugin-web-extension": "^4.4.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "chrome-extension",
    "tabs",
    "arc-browser",
    "productivity"
  ],
  "author": "Nisarg Kolhe",
  "packageManager": "pnpm@10.32.1",
  "license": "GPL-3.0",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-context-menu": "2.2.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
